digraph G { rankdir=BT; node [shape=record,fontname="Helvetica",fontsize=10,style=filled,fillcolor="#e0f2fe"]; edge [fontname="Helvetica",fontsize=9];
 User [label="{User|- username: String\l- password: String\l- role: Role\l|+ checkPassword(String): boolean\l+ isAdmin(): boolean\l+ getRole(): Role\l}"];
 Book [label="{Book|- id: int\l- title: String\l- author: String\l- category: String\l- totalCopies: int\l- availableCopies: int\l|+ isAvailable(): boolean\l+ borrowCopy(): void\l+ returnCopy(): void\l+ matches(String): boolean\l}"];
 Member [label="{Member|- id: int\l- name: String\l- email: String\l- phone: String\l|+ getName(): String\l+ getEmail(): String\l}"];
 IssueRecord [label="{IssueRecord|- id: int\l- bookId: int\l- memberId: int\l- issueDate: LocalDate\l- dueDate: LocalDate\l- returnDate: LocalDate\l- fineAmount: double\l|+ isOverdue(): boolean\l+ markReturned(LocalDate): double\l}"];
 Fine [label="{Fine|- daysLate: long\l- amount: double\l+ RATE_PER_DAY: double\l|+ getDaysLate(): long\l+ getAmount(): double\l}"];
 LibraryService [label="{LibraryService|- users: List\<User\>\l- books: List\<Book\>\l- members: List\<Member\>\l- records: List\<IssueRecord\>\l|+ login(String,String): User\l+ addBook(...): Book\l+ searchBooks(String): List\<Book\>\l+ addMember(...): Member\l+ issueBook(int,int): String\l+ returnBook(int): double\l+ getOverdueRecords(): List\l}",fillcolor="#fef3c7"];
 MainFrame [label="{MainFrame (GUI)|- service: LibraryService\l- user: User\l|+ refreshAll(): void\l}",fillcolor="#dcfce7"];
 LoginFrame [label="{LoginFrame (GUI)|- service: LibraryService\l|+ doLogin(): void\l}",fillcolor="#dcfce7"];
 LibraryService -> User [arrowhead=odiamond,label="1..*",headlabel=""]; LibraryService -> Book [arrowhead=odiamond,label="0..*"];
 LibraryService -> Member [arrowhead=odiamond,label="0..*"]; LibraryService -> IssueRecord [arrowhead=odiamond,label="0..*"];
 IssueRecord -> Book [arrowhead=open,label="issues"]; IssueRecord -> Member [arrowhead=open,label="borrowed by"];
 IssueRecord -> Fine [arrowhead=open,style=dashed,label="uses"];
 LoginFrame -> LibraryService [arrowhead=open]; MainFrame -> LibraryService [arrowhead=open]; LoginFrame -> MainFrame [arrowhead=open,style=dashed,label="opens"];
}
