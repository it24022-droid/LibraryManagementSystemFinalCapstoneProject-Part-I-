digraph G { rankdir=LR; node [fontname="Helvetica",fontsize=10]; edge [arrowhead=none];
 subgraph cluster0 { label="Library Management System"; style=rounded; fontname="Helvetica";
  node [shape=ellipse,style=filled,fillcolor="#e0f2fe"];
  u1 [label="Login"]; u2 [label="Manage Books\n(add / update / delete)"]; u3 [label="Search Books"];
  u4 [label="Register Member"]; u5 [label="Issue Book"]; u6 [label="Return Book"];
  u7 [label="Calculate Fine"]; u8 [label="View Overdue Report"]; u9 [label="Manage Users"]; }
 admin [label="Admin",shape=box]; lib [label="Librarian",shape=box]; mem [label="Member",shape=box];
 admin -> u1; admin -> u2; admin -> u9; admin -> u8; admin -> u3;
 lib -> u1; lib -> u4; lib -> u5; lib -> u6; lib -> u3; lib -> u8;
 mem -> u3; mem -> u4;
 u6 -> u7 [style=dashed,arrowhead=open,label="<<include>>",fontsize=9];
}
