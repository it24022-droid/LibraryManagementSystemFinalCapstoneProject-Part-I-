digraph G { rankdir=LR; node [fontname="Helvetica",fontsize=10]; edge [fontname="Helvetica",fontsize=9];
 admin [label="Admin",shape=box]; lib [label="Librarian",shape=box]; mem [label="Member",shape=box];
 p1 [label="1.0\nAuthenticate\nUser",shape=circle,style=filled,fillcolor="#dbeafe"];
 p2 [label="2.0\nManage\nBooks",shape=circle,style=filled,fillcolor="#dbeafe"];
 p3 [label="3.0\nManage\nMembers",shape=circle,style=filled,fillcolor="#dbeafe"];
 p4 [label="4.0\nIssue / Return\nBooks",shape=circle,style=filled,fillcolor="#dbeafe"];
 p5 [label="5.0\nCalculate\nFine",shape=circle,style=filled,fillcolor="#dbeafe"];
 p6 [label="6.0\nGenerate\nReports",shape=circle,style=filled,fillcolor="#dbeafe"];
 d1 [label="D1 Users",shape=cds]; d2 [label="D2 Books",shape=cds]; d3 [label="D3 Members",shape=cds]; d4 [label="D4 IssueRecords",shape=cds];
 admin -> p1 [label="credentials"]; lib -> p1 [label="credentials"]; p1 -> d1 [dir=both];
 admin -> p2 [label="book details"]; p2 -> d2 [dir=both];
 mem -> p3 [label="member details"]; lib -> p3; p3 -> d3 [dir=both];
 lib -> p4 [label="book id, member id"]; d2 -> p4; d3 -> p4; p4 -> d4 [dir=both];
 p4 -> p5 [label="due / return date"]; p5 -> d4 [label="fine"];
 d4 -> p6; d2 -> p6; p6 -> admin [label="reports"];
 mem -> p2 [label="search query",style=dashed];
}
