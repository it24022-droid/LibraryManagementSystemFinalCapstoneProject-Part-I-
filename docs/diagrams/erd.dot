graph G { layout=neato; overlap=false; splines=true; node [fontname="Helvetica",fontsize=10]; edge [fontname="Helvetica",fontsize=10];
 node [shape=record,style=filled,fillcolor="#e0f2fe"];
 Users [label="{Users|PK username\l password\l role\l}",pos="0,3!"];
 Books [label="{Books|PK book_id\l title\l author\l FK category_id\l total_copies\l available_copies\l}",pos="3,0!"];
 Categories [label="{Categories|PK category_id\l category_name\l}",pos="6.5,0!"];
 Members [label="{Members|PK member_id\l name\l email\l phone\l}",pos="-3,0!"];
 IssueRecords [label="{IssueRecords|PK issue_id\l FK book_id\l FK member_id\l FK handled_by (username)\l issue_date\l due_date\l return_date\l fine_amount\l}",pos="0,-3.2!"];
 node [shape=diamond,style=filled,fillcolor="#fef3c7"];
 r1 [label="belongs to",pos="4.8,0!"]; r2 [label="borrows",pos="-1.7,-2!"]; r3 [label="is issued",pos="2.2,-2!"]; r4 [label="handles",pos="0,0.8!"];
 Books -- r1 [label="N"]; r1 -- Categories [label="1"];
 Members -- r2 [label="1"]; r2 -- IssueRecords [label="N"];
 Books -- r3 [label="1"]; r3 -- IssueRecords [label="N"];
 Users -- r4 [label="1"]; r4 -- IssueRecords [label="N"];
}
