digraph G { node [fontname="Helvetica",fontsize=10,shape=box,style="rounded,filled",fillcolor="#e0f2fe"]; edge [fontname="Helvetica",fontsize=9];
 s [label="",shape=circle,width=0.2,style=filled,fillcolor=black]; e [label="",shape=doublecircle,width=0.2,style=filled,fillcolor=black];
 a1 [label="Librarian logs in"]; a2 [label="Enter Book ID and Member ID"];
 d1 [label="Book available and\nmember valid?",shape=diamond,style=filled,fillcolor="#fef3c7"];
