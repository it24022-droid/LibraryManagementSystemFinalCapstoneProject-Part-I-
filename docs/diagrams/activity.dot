 a8 [label="Fine = days late x Tk 5"]; a9 [label="No fine"]; a10 [label="Increase available copies,\nsave data"];
 s->a1->a2->d1; d1->a3 [label="No"]; a3->e; d1->d2 [label="Yes"]; d2->a3 [label="No"]; d2->a4 [label="Yes"];
 a4->a5->a6->a7->d3; d3->a8 [label="Yes"]; d3->a9 [label="No"]; a8->a10; a9->a10; a10->e;
